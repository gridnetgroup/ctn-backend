# Whop (whop.com/dashboard -> Settings, the biz_... in your dashboard URL)
WHOP_COMPANY_ID=biz_...
# Whop (whop.com/dashboard -> Developer -> API Keys -> Account API key)
WHOP_API_KEY=sk_...
# Whop (whop.com/dashboard -> Developer -> Webhooks -> Create Webhook,
# event: payment.succeeded -> copy the signing secret)
WHOP_WEBHOOK_SECRET=whsec_...

# Resend (resend.com -> API Keys)
RESEND_API_KEY=re_...
FROM_EMAIL=Caribbean Tech News <releases@caribbeantechnews.com>

# Where the public site is hosted — used to build the post-checkout redirect
# URL and links inside emails. No trailing slash.
FRONTEND_URL=https://caribbeantechnews.com

# Where THIS backend is reachable from the internet — used to build the
# webhook URL you'll register in the Whop dashboard. No trailing slash.
BACKEND_URL=https://api.caribbeantechnews.com

# Optional: internal inbox that gets pinged when a new paid submission lands
EDITOR_ALERT_EMAIL=editors@caribbeantechnews.com
# Optional: used in that alert email to link straight to the console
ADMIN_URL=https://caribbeantechnews.com/admin.html

PORT=4000
